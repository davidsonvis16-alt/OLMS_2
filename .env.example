# Supabase (Project settings > API). All three are required: without them the site shows "not configured"
# instead of running. There is no demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never paste it into browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used in certificate QR codes and payment callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (Kenya). Card payments are charged in USD, M-Pesa in KES. Server only.
# Also set the webhook URL in the Paystack dashboard to <site>/api/pay/webhook
PAYSTACK_SECRET_KEY=
# KES per 1 USD, used to quote M-Pesa payments. Set the rate the client wants to use.
USD_TO_KES=

# Admin accounts, separated by commas. `npm run seed` promotes each one once it has signed up and confirmed its email.
ADMIN_EMAIL=Aspiresafetystandards@gmail.com,davidson.vis.16@gmail.com
